{
  "expo": {
    "name": "Buscador",
    "slug": "buscador",
    "scheme": "buscador",
    "version": "1.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090B11",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090B11",
          "image": "./assets/buscador-splash.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#090B11",
            "image": "./assets/buscador-splash.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "./plugins/withBuscadorNotificationBridge"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.flaviodelacruz.buscador",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/buscador-splash.png",
        "backgroundColor": "#090B11"
      },
      "allowBackup": false
    },
    "newArchEnabled": true,
    "icon": "./assets/buscador-icon.png"
  }
}
