<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app only uses network access when the user explicitly exports their archive. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only the user can grant this special access in Android Settings. -->
    <application
        android:label="@string/app_name"
        android:icon="@drawable/buscador_logo"
        android:roundIcon="@drawable/buscador_logo"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Buscador"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".BuscadorNotificationListener"
            android:exported="false"
            android:label="Buscador · Historial autorizado"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
